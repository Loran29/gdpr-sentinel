# OpenRouter API key — required for live LLM classification.
# If unset on first scan, the pipeline falls back to a filename-based stub classifier.
OPENROUTER_API_KEY=

# OpenRouter model — overridable without code changes.
OPENROUTER_MODEL=google/gemini-2.5-flash

# OpenRouter base URL — do not change unless self-hosting.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Path to the data root the local-folder connector walks.
DATA_ROOT=./data

# Path to the master-of-data routing config.
MASTER_OF_DATA_CONFIG=./master_of_data.yaml
